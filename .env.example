# NutriMind Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# LLM API Configuration (ModelScope/OpenAI兼容)
# ============================================
# ModelScope API (推荐用于国内访问)
# 获取API Key: https://www.modelscope.cn/my/my-settings
MODELSCOPE_API_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_TOKEN=ms-your-model-scope-token-here

# OpenAI API (备选/兼容)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1

# ============================================
# OCR API Configuration
# ============================================
# 智谱 AI OCR (推荐)
# 注册地址: https://www.bigmodel.cn/devcenter/applist
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 百度 OCR (备选)
# 注册地址: https://ai.baidu.com/tech/ocr
BAIDU_OCR_API_KEY=your-baidu-api-key-here
BAIDU_OCR_SECRET_KEY=your-baidu-secret-key-here

# ============================================
# Database (生产环境配置)
# ============================================
DATABASE_URL=postgresql://nutrimind:nutrimind123@localhost:5432/nutrimind
REDIS_URL=redis://localhost:6379

# ============================================
# Neo4j Knowledge Graph (可选)
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100

# ============================================
# WebSocket
# ============================================
WS_MAX_PAYLOAD=1048576

# ============================================
# MCP Servers (可选)
# ============================================
HOWTECOOK_MCP_URL=
NUTRITION_DB_URL=
FOOD_RECOGNITION_URL=

# ============================================
# Voice AI
# ============================================
VOICE_AI_ENABLED=false

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Knowledge Base Paths
# ============================================
KB_PATH=./kb
RECIPES_PATH=./kb/recipes
