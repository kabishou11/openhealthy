# NutriMind Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# JWT Authentication
JWT_SECRET=nutrimind-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Database
DATABASE_URL=./data/nutrimind.db

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# ModelScope API (for LLM)
# Get token from: https://www.modelscope.cn/my/token
MODELSCOPE_TOKEN=

# OpenAI API (alternative)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api-inference.modelscope.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# OCR Service
OCR_URL=http://localhost:8081

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# SMS Service (optional)
# Aliyun SMS configuration
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=NutriMind

# WeChat (optional)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
