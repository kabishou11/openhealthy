# NutriMind Frontend Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# API Keys - 获取地址: https://www.modelscope.cn/my/myapi
# ==============================================================================
# ModelScope API Key (用于AI对话和模型选择)
MODELSCOPE_API_KEY=your_modelscope_api_key_here

# OpenAI Compatible API Key (可选，支持 OpenAI 格式的 API)
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Backend API Configuration
# ==============================================================================
# Backend API base URL (NutriMind 后端服务)
API_BASE=http://localhost:3001/api/v1

# WebSocket URL for real-time features
WS_URL=ws://localhost:3001/ws

# ==============================================================================
# MCP Servers Configuration (Model Context Protocol)
# HowToCook MCP: https://github.com/worryzyy/HowToCook-mcp
# ==============================================================================
# Enable/Disable MCP servers
MCP_ENABLED=true

# HowToCook MCP Server
# 提供 343 道家常菜谱查询功能
HOWTOCOOK_MCP_URL=http://localhost:3001/mcp/howtocook

# Nutrition MCP Server (可选)
# 提供食物营养成分数据库
NUTRITION_MCP_URL=http://localhost:3001/mcp/nutrition

# Food Analysis MCP Server (可选)
# 提供食物图像识别功能
FOOD_ANALYSIS_MCP_URL=http://localhost:3001/mcp/food-analysis

# ==============================================================================
# OCR Configuration
# ==============================================================================
# OCR API URL (可选，用于体检表识别)
OCR_API_URL=https://api.ocr.space/parse/imageurl
OCR_API_KEY=your_ocr_space_api_key_here

# ==============================================================================
# Feature Flags
# ==============================================================================
# 启用演示模式 (无 API 密钥时使用)
DEMO_MODE=false

# 启用高级动画效果
ENABLE_ANIMATIONS=true

# 启用 WebGL 流体光标 (桌面端)
ENABLE_FLUID_CURSOR=true

# ==============================================================================
# Application Settings
# ==============================================================================
# 应用名称
NUXT_PUBLIC_APP_NAME=NutriMind

# 默认语言
NUXT_PUBLIC_DEFAULT_LOCALE=zh-CN

# 默认主题 (light | dark | system)
NUXT_COLOR_MODE_PREFERENCE=light
